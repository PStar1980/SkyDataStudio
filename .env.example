# SkyData Studio application
SKYDATA_ENVIRONMENT=development
SKYDATA_API_HOST=127.0.0.1
SKYDATA_API_PORT=8100
SKYDATA_WEB_ORIGIN=http://localhost:5174
SKYDATA_DATABASE_URL=postgresql+psycopg://skydata:skydata@localhost:5440/skydata_studio

# SkyCommand integration (read-only consumer boundary)
# For internal mode, use the same secret configured as SKYCOMMAND_INTERNAL_API_TOKEN
# in the SkyCommand environment. Bearer mode accepts a SkyCommand session token.
SKYCOMMAND_API_BASE_URL=http://localhost:7171/api
SKYCOMMAND_API_AUTH_MODE=internal
SKYCOMMAND_API_TOKEN=your_shared_local_secret
SKYCOMMAND_API_TIMEOUT_SECONDS=8
SKYCOMMAND_OFFLINE_PREVIEW_ENABLED=true

# Airflow integration is intentionally API-based; do not read its metadata DB.
AIRFLOW_API_BASE_URL=http://localhost:8080/api/v2
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
